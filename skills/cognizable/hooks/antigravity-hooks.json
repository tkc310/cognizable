{
  "cognizable": {
    "PreInvocation": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/skills/cognizable/hooks/cognizable_hook.py antigravity:PreInvocation", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/skills/cognizable/hooks/cognizable_hook.py antigravity:PreToolUse", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/skills/cognizable/hooks/cognizable_hook.py antigravity:Stop", "timeout": 10 }
        ]
      }
    ]
  }
}
